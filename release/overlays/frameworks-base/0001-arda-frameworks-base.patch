+                    boolean asProto) {
+                dump(fd, pw, new String[] {"-a"}, asProto);
+            }
+
+            @Override
+            public void dump(FileDescriptor fd, PrintWriter pw, String[] args, boolean asProto) {
+                mActivityManagerService.dumpApplicationMemoryUsage(
+                        fd, pw, "  ", args, false, null, asProto);
