+                    }
+                }
+            }
+        }
+
+        long nativeProcTotalPss = 0;
+
+        if (collectNative) {
+            mi = null;
+            final Debug.MemoryInfo[] memInfos = new Debug.MemoryInfo[1];
+            mAppProfiler.forAllCpuStats((st) -> {
+                if (st.vsize > 0 && procMemsMap.indexOfKey(st.pid) < 0) {
+                    if (memInfos[0] == null) {
