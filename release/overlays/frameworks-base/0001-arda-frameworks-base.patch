+        Collections.sort(items, new Comparator<MemItem>() {
+            @Override
+            public int compare(MemItem lhs, MemItem rhs) {
+                long lss = pss ? lhs.pss : lhs.mRss;
+                long rss = pss ? rhs.pss : rhs.mRss;
+                if (lss < rss) {
+                    return 1;
+                } else if (lss > rss) {
+                    return -1;
+                }
+                return 0;
+            }
+        });
+    }
