+                    ss[INDEX_OTHER_PSS] -= mem;
+                    mem = mi.getOtherSwappedOutPss(j);
+                    miscSwapPss[j] += mem;
+                    ss[INDEX_OTHER_SWAP_PSS] -= mem;
+                    mem = mi.getOtherRss(j);
+                    miscRss[j] += mem;
+                    ss[INDEX_OTHER_RSS] -= mem;
+                }
