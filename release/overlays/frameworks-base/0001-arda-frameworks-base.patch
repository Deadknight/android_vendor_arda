+            } else if ("cao".equals(cmd)) {
+                mCachedAppOptimizer.dump(pw);
+            } else if ("timers".equals(cmd)) {
+                AnrTimer.dump(pw, true);
+            } else if ("services".equals(cmd) || "s".equals(cmd)) {
+                if (dumpClient) {
