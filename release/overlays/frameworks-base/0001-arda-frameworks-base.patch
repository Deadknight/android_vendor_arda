+                if (!isAppDebuggable && !isAppProfileable) {
+                    throw new SecurityException("Process not debuggable, "
+                            + "and not profileable by shell: " + app.packageName);
+                }
+            }
+            mAppProfiler.setProfileAppLPf(processName, profilerInfo, profileType);
+        }
