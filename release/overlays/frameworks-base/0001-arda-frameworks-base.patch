+    final void ensureBootCompleted() {
+        boolean booting;
+        boolean enableScreen;
+        synchronized (this) {
+            booting = mBooting;
+            mBooting = false;
+            enableScreen = !mBooted;
+            mBooted = true;
+        }
+
+        if (booting) {
+            finishBooting();
+        }
+
+        if (enableScreen) {
+            mAtmInternal.enableScreenAfterBoot(mBooted);
+        }
+    }
