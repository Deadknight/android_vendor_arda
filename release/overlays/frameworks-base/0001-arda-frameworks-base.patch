+        public void printComponentShortName(PrintWriter pw) {
+            ComponentName.printShortString(pw, owner.applicationInfo.packageName, className);
+        }
+
+        public void setPackageName(String packageName) {
+            componentName = null;
+            componentShortName = null;
+        }
+    }
