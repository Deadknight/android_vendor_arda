+            }
+
+            final long myTotalPss = mi.getTotalPss();
+            final long myTotalUss = mi.getTotalUss();
+            final long myTotalRss = mi.getTotalRss();
+            final long myTotalSwapPss = mi.getTotalSwappedOutPss();
