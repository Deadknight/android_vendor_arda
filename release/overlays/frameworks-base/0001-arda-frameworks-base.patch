+    @GuardedBy("mProcLock")
+    private boolean processSanityChecksLPr(ProcessRecord process, IApplicationThread thread) {
+        if (process == null || thread == null) {
+            return false;
+        }
+
+        return Build.IS_DEBUGGABLE || process.isDebuggable();
+    }
