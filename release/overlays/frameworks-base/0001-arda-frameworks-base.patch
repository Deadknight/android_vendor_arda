+    private boolean shouldArdaBlockRedundantHome(int displayId) {
+        if (!mHasFeatureAuto) {
+            return false;
+        }
+
+        try {
+            final List<RootTaskInfo> rootTasks =
+                    ActivityTaskManager.getService().getAllRootTaskInfosOnDisplay(displayId);
+            if (rootTasks == null) {
+                return false;
+            }
+
+            for (RootTaskInfo info : rootTasks) {
+                if (info == null || !info.visible || info.topActivity == null) {
+                    continue;
+                }
+
+                if (info.configuration.windowConfiguration.getActivityType()
+                                == android.app.WindowConfiguration.ACTIVITY_TYPE_HOME
+                        && "com.android.car.carlauncher".equals(
+                                info.topActivity.getPackageName())) {
+                    return true;
+                }
+            }
+        } catch (RemoteException e) {
+            Slog.w(TAG, "ARDA_HOME_BLOCK query failed", e);
+        }
+
+        return false;
+    }
