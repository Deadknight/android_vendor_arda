+            mBooting = false;
+            enableScreen = !mBooted;
+            mBooted = true;
+        }
+
+        if (booting) {
+            finishBooting();
+        }
+
+        if (enableScreen) {
+            mAtmInternal.enableScreenAfterBoot(mBooted);
+        }
+    }
